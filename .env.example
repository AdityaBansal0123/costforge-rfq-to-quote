# =============================================================================
# CostForge Chakan — Environment Variables Template (NAMES ONLY — NO SECRETS)
# Copy this file to .env before running locally: cp .env.example .env
# =============================================================================
APP_ENV=development
PORT=8000
DATABASE_URL=sqlite:///./chakan_costforge.db
SESSION_SECRET_KEY=
JWT_SIGNING_KEY=
NDA_WATERMARK_SALT=

# Enterprise Zero-Retention AI Extraction Endpoint (No training on customer CAD/RFQs)
AI_EXTRACTION_PROVIDER=local_deterministic_or_azure_openai_zero_retention
AI_ENDPOINT_URL=
AI_API_KEY=
AI_ZERO_RETENTION_HEADER=true

# Commercial Policy Constants
SALES_HEAD_APPROVAL_THRESHOLD_INR=2500000
DEFAULT_GST_RATE_PCT=18.0
SLA_TARGET_WORKING_DAYS=4.0
